generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model User {
  id Int @id @default(autoincrement())
  email String @unique
}
model Session {
  token String @id
}
model Document {
  id Int @id @default(autoincrement())
  tenant String
  status String
}
