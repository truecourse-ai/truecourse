# TrueCourse environment.
#
# Copy this to `.env` beside it. The server reads that one file at boot
# (`packages/core/src/config/env.ts` walks up to the workspace root), and
# `docker compose` reads the same file for the Postgres defaults at the bottom.
# Never commit it.

# ---------------------------------------------------------------------
# REQUIRED for every deployment. The server refuses to boot without both.
# ---------------------------------------------------------------------

# Postgres. All state lives here, and the migrations are applied at boot.
# Locally, `docker compose up -d` serves exactly this URL.
DATABASE_URL=postgres://truecourse:truecourse@localhost:5432/truecourse

# Master secret (32+ characters) that encrypts each workspace's saved LLM
# provider key and each repository's dependency overlays. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TRUECOURSE_SECRET_KEY=replace-with-a-strong-32-byte-secret

# ---------------------------------------------------------------------
# HOSTED MODE, which is how a server runs when TRUECOURSE_MODE is unset.
# ---------------------------------------------------------------------

# Session auth via WorkOS AuthKit (WorkOS dashboard, API Keys). These three are
# required in hosted mode: boot fails if any of them is missing.
WORKOS_API_KEY=YOUR_WORKOS_API_KEY
WORKOS_CLIENT_ID=YOUR_WORKOS_CLIENT_ID
# Seals the session cookie, 32+ characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WORKOS_COOKIE_PASSWORD=replace-with-a-32-byte-base64-secret

# Where WorkOS sends the browser after login. Register this exact URL as a
# redirect URI on the WorkOS app. Default: http://localhost:3001/api/auth/callback
# WORKOS_REDIRECT_URI=http://localhost:3001/api/auth/callback
# The dashboard origin that callback finally lands on, and the origin the
# GitHub App connect callback returns to. Default: http://localhost:3000
# WORKOS_APP_URL=http://localhost:3000

# GitHub App: how a repository is connected. All six or none: with none set
# the server boots without GitHub and the /api/github routes answer 503 naming
# what is unset; with some set the boot fails naming the rest. From the App's
# settings page (Settings, Developer settings, GitHub Apps).
# GITHUB_APP_ID=123456
# Private key PEM. Use a raw PEM, an escaped single-line PEM (\n), or a
# base64-encoded PEM, which is easiest in an env file:
#   base64 -i your-app.private-key.pem | tr -d '\n'
# GITHUB_APP_PRIVATE_KEY=base64-or-pem
# Webhook secret configured on the App; it verifies inbound deliveries.
# GITHUB_APP_WEBHOOK_SECRET=replace-with-the-app-webhook-secret
# App slug from its public URL (github.com/apps/<slug>); builds the install link.
# GITHUB_APP_SLUG=truecourse
# The App's OAuth client (Client ID on the settings page; generate a client
# secret there). Connect authorizes the person with GitHub, and the code that
# comes back is exchanged to learn which installations of the App they can
# reach — that is what lets two workspaces attach the same GitHub account.
# GITHUB_APP_CLIENT_ID=Iv1.0123456789abcdef
# GITHUB_APP_CLIENT_SECRET=replace-with-the-app-client-secret
#
# On the App's settings page:
#   Webhook URL  -> a public URL for POST /api/github/webhook
#                   (local dev: an ngrok tunnel to :3001)
#   Callback URL -> http://localhost:3001/api/github/callback
#   Enable "Request user authorization (OAuth) during installation".
#   The Setup URL and "Redirect on update" are unused.

# ---------------------------------------------------------------------
# LOCAL MODE, which is one developer's machine.
# ---------------------------------------------------------------------

# `local` means no sign-in, one implicit person in one implicit workspace, and
# folders on this machine connectable as repositories; the WORKOS_* block above
# is then unused. Unset or `hosted` is a hosted deployment. Any other value
# fails boot rather than being guessed at.
# TRUECOURSE_MODE=local

# ---------------------------------------------------------------------
# OPTIONAL in either mode.
# ---------------------------------------------------------------------

# HTTP port the server listens on. Default: 3001.
# PORT=3001

# Machine-local scratch, never state: the per-run clones, the run watch
# journals, and the server log. Default: ~/.truecourse-runtime.
# TRUECOURSE_RUNTIME_DIR=/var/lib/truecourse/runtime
# Relocates the log alone. Default: <runtime dir>/logs.
# TRUECOURSE_LOG_DIR=/var/log/truecourse

# Set by `pnpm dev`: tees the server log to stderr and reports the Sentry
# environment as development.
# TRUECOURSE_DEV=1
# Build tag this process reports on GET /api/health, so a deploy can tell the
# new process from the one it replaced.
# TRUECOURSE_RELEASE=

# OPERATOR MODE, for a self-hosted single-operator instance only: every
# workspace runs on this process's own `claude` login instead of the provider it
# saved, and the Models page becomes read-only. Never set it on a shared deploy.
# A workspace's provider key is saved in-app, encrypted in Postgres; there is no
# env fallback for it.
# TRUECOURSE_LLM_TRANSPORT=claude-code
# The `claude` binary operator mode spawns. Default: `claude` on PATH.
# CLAUDE_CODE_BINARY=claude

# The model operator mode runs everything on. Default: opus.
# TRUECOURSE_FALLBACK_MODEL is what a call retries on when the primary is
# overloaded.
# TRUECOURSE_MODEL=
# TRUECOURSE_FALLBACK_MODEL=

# The clocks on a leaf judgement (a one-turn session): no event from the
# provider for the stall timeout (ms, default 300000) stops it as stalled, and
# the whole session is bounded at 600000 ms. The scale (a float, default 1)
# multiplies both.
# TRUECOURSE_LLM_TIMEOUT_SCALE=1
# TRUECOURSE_LLM_STALL_TIMEOUT_MS=300000

# How much parallel work at once. Defaults: min(cpus, 4) for agent sessions,
# min(cpus, 8) for a run's scenarios, and min(general, 3) for the API driver's
# server boots, which can never exceed the general width.
# TRUECOURSE_MAX_CONCURRENCY=4
# TRUECOURSE_MAX_API_CONCURRENCY=3

# The one LLM call a run can make: a vision verdict on a failing web step's
# screenshot. Off unless this is set, and annotation-only when on.
# TRUECOURSE_GUARD_VISUAL_JUDGE=1

# Sentry error reporting. Leave SENTRY_DSN unset to disable it.
# SENTRY_ENVIRONMENT defaults to development under TRUECOURSE_DEV, else
# NODE_ENV, else production. SENTRY_RELEASE falls back to TRUECOURSE_RELEASE.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.de.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# NODE_ENV=production

# Product analytics. The server sends one event per background job that
# finished — the outcome, how long it took, and the repository it was for; the
# client sends the rest. POSTHOG_DISABLED=1 turns off BOTH (the client build
# reads it from here too); the other two send the server's events to your own
# PostHog project instead of TrueCourse's.
# POSTHOG_DISABLED=1
# POSTHOG_KEY=phc_yourprojectkey
# POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------
# docker-compose.yml reads this same file for its Postgres container. The
# defaults below are what DATABASE_URL at the top already points at; change
# the two together.
# ---------------------------------------------------------------------
# POSTGRES_USER=truecourse
# POSTGRES_PASSWORD=truecourse
# POSTGRES_DB=truecourse
