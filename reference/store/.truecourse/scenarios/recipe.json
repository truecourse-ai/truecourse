{
  "install": "pnpm install --frozen-lockfile",
  "build": "pnpm run build",
  "entry": [
    "node",
    "tools/cli/dist/index.js"
  ],
  "expose": {
    "truecourse": [
      "node",
      "tools/cli/dist/index.js"
    ]
  },
  "web": {
    "build": "pnpm build:dist",
    "serve": [
      "node",
      "dist/server.mjs"
    ],
    "healthPath": "/api/health",
    "readyTimeoutMs": 60000
  }
}
