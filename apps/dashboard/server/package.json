{
  "name": "@truecourse/dashboard-server",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "truecourse-source": "./src/edition.ts",
      "types": "./dist/edition.d.ts",
      "import": "./dist/edition.js"
    }
  },
  "scripts": {
    "dev": "TRUECOURSE_DEV=1 tsx watch --conditions=truecourse-source src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@sentry/node": "^10.0.0",
    "@truecourse/agent-loop": "workspace:*",
    "@truecourse/core": "workspace:*",
    "@truecourse/data-store": "workspace:*",
    "@truecourse/db": "workspace:*",
    "@truecourse/github-app": "workspace:*",
    "@truecourse/jobs": "workspace:*",
    "@truecourse/shared": "workspace:*",
    "@truecourse/spec-consolidator": "workspace:*",
    "@workos-inc/node": "^7.0.0",
    "ai": "^6.0.0",
    "chokidar": "^4.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "jose": "^6.2.1",
    "posthog-node": "^5.52.4",
    "socket.io": "^4.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
