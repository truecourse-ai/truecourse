# Env vars for the landing site.
# Copy to .env.local for local dev, or set in your host's project settings.
# Never commit real values.

# ─── Hosted app (client) ─────────────────────────────────────────────────────
# Where every "Get started" / "Sign in" link points. Default is baked into
# src/lib/app-url.ts: https://app.truecourse.dev
# Override for staging or preview deployments.
# VITE_APP_URL=https://app.truecourse.dev

# ─── PostHog (client analytics) ──────────────────────────────────────────────
# Defaults baked into src/lib/posthog.ts:
#   VITE_POSTHOG_KEY  = phc_ys9Ykf49KmNqAC3fhq3jugTejc4BDqyKqRS8qRoYZYew
#                       (same project as the dashboard app;
#                        events tagged source='landing' to distinguish them)
#   VITE_POSTHOG_HOST = https://us.i.posthog.com
# Override only if you want to point landing at a different project (staging
# experiments, etc.). The default is correct for production.
# VITE_POSTHOG_KEY=phc_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# ─── PostHog (server, api/blog-views.ts) ─────────────────────────────────────
# Read the per-post view counts. Server-only, never exposed to the browser.
#   POSTHOG_PERSONAL_API_KEY  Personal API key with `query:read` scope
#   POSTHOG_PROJECT_ID        Numeric project id (Settings → Project)
#   POSTHOG_API_HOST          Optional, defaults to https://us.posthog.com
# POSTHOG_PERSONAL_API_KEY=your-personal-api-key
# POSTHOG_PROJECT_ID=00000
# POSTHOG_API_HOST=https://us.posthog.com
